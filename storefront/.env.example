VITE_API_URL=http://localhost:5001

# Optional. Unset => falls back to a dummy client ID (App.jsx) and Google
# sign-in still works against the backend's unverified dev fallback (see
# backend/.env.example's GOOGLE_CLIENT_ID comment). Only needed for a real
# signature-verified Google OAuth flow.
VITE_GOOGLE_CLIENT_ID=

# Milestone 5 — which backend the storefront reads products/categories/
# search/customer-accounts from. "pos" (default) keeps every flow exactly
# as it works today, reading from backend/ at VITE_API_URL above.
# "marketplace" switches browsing + customer accounts to marketplace-backend/
# at VITE_MARKETPLACE_API_URL below; checkout stays a "coming soon — order
# on WhatsApp" message in that mode until Milestone 6.
VITE_DATA_SOURCE=pos
VITE_MARKETPLACE_API_URL=http://localhost:5002
# Only used for the footer's "Sell on Apexora" link -> `${VITE_CONSOLE_URL}/apply`.
VITE_CONSOLE_URL=http://localhost:5175
