PORT=5002
NODE_ENV=development

# Local/dev MUST use a database named apexora_dev (or apexora_test for the
# test runner) — never sparepartspos or storefront_dev (the POS's own
# databases) and never the real apexora production database. config/db.js
# refuses to start otherwise, and every standalone script goes through
# scripts/lib/loadDevEnv.js, which applies the same guard before connecting.
MONGO_URI=your_mongodb_connection_string

# Marketplace's own secret — never reuse backend/'s JWT_SECRET. Access
# tokens are short-lived (15m); REFRESH_TOKEN_SECRET signs the longer-lived
# refresh token separately, so a leaked access token can't be used to mint
# new ones.
JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret

# Milestone 4: encrypts a seller's POS integration key at rest
# (services/encryption.js) — must be exactly 32 bytes, hex-encoded (64
# hex characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POS_KEY_ENCRYPTION_SECRET=

# Comma-separated list of allowed origins — console/ and, since
# Milestone 5, the storefront/ in marketplace mode. No wildcard default —
# unlike backend/, nothing here is relied on being reachable from
# arbitrary origins.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175
