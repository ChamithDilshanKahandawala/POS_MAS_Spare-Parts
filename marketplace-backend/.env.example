PORT=5002
NODE_ENV=development

# Local/dev MUST use a database named apexora_dev (or apexora_test for the
# test runner) — never sparepartspos or storefront_dev (the POS's own
# databases) and never the real apexora production database. config/db.js
# refuses to start otherwise, and every standalone script goes through
# scripts/lib/loadDevEnv.js, which applies the same guard before connecting.
MONGO_URI=your_mongodb_connection_string

# Marketplace's own secret — never reuse backend/'s JWT_SECRET. Access
# tokens are short-lived (15m); REFRESH_TOKEN_SECRET signs the longer-lived
# refresh token separately, so a leaked access token can't be used to mint
# new ones.
JWT_ACCESS_SECRET=your_access_token_secret
JWT_REFRESH_SECRET=your_refresh_token_secret

# Milestone 4: encrypts a seller's POS integration key at rest
# (services/encryption.js) — must be exactly 32 bytes, hex-encoded (64
# hex characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POS_KEY_ENCRYPTION_SECRET=

# Comma-separated list of allowed origins — console/ and, since
# Milestone 5, the storefront/ in marketplace mode. No wildcard default —
# unlike backend/, nothing here is relied on being reachable from
# arbitrary origins.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175

# --- Milestone 9: email + SMS ---
# "console" prints messages to the server log (dev/test default). Real
# provider adapters are selected here once chosen; keys go in
# .env.development / production env, never in Git.
EMAIL_PROVIDER=console
SMS_PROVIDER=console
# Links inside emails
STOREFRONT_URL=http://localhost:5174
CONSOLE_URL=http://localhost:5175
# OTP throttling (per user, shared by login and step-up codes)
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DAILY_LIMIT=10

# --- Milestone 11: operations ---
# Key rotation: the previous value keeps old tokens/encrypted POS keys valid
# while a rotation is in progress (see README "Key rotation"). Leave empty
# normally.
JWT_ACCESS_SECRET_PREVIOUS=
JWT_REFRESH_SECRET_PREVIOUS=
POS_KEY_ENCRYPTION_SECRET_PREVIOUS=
# JSON log lines (always on in production); LOG_REQUESTS=true logs every
# request outside production too.
LOG_FORMAT=
LOG_REQUESTS=

# --- Milestone 11: file storage ---
# local (default, files under uploads/) or s3 (any S3-compatible bucket:
# AWS S3, Cloudflare R2, MinIO). Keep the bucket private — the API serves
# every file and checks who may see it. Move existing files with
# `node scripts/migrateStorage.js` (see README "Operations").
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com (leave empty for AWS S3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
