PORT=5001
NODE_ENV=development
# Local/dev MUST use a dev-only database user — never the production
# credentials, even pointed at a different database name. Create a
# dedicated Atlas user scoped to readWrite on the dev database only
# (e.g. storefront_dev); that way a leaked or misused dev .env can't
# touch production data no matter what MONGO_URI inside it says.
# config/db.js will also refuse to start if this ever resolves to the
# production database name while NODE_ENV isn't "production".
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_secret_key

# CORS allow-list extra entry — only needed if your frontend isn't on
# localhost/*.vercel.app/*.railway.app already (see server.js).
FRONTEND_URL=http://localhost:5174

# Optional in dev, required in production. Unset + NODE_ENV=development =>
# Google sign-in decodes the token without verifying its signature (local
# testing only, never reachable outside literal NODE_ENV=development).
# Unset + any other NODE_ENV => the /api/auth/google route returns 503
# rather than trust an unverified token (see authController.js). Set a
# real OAuth client ID to turn on signature verification in every env.
GOOGLE_CLIENT_ID=

# Optional, both default to "off" when unset (see services/productSearchService.js).
USE_ATLAS_SEARCH=
MONGODB_ATLAS_SEARCH_INDEX=

# Shared secret for GET /api/integration/products (read-only product feed
# for the Apexora marketplace — routes/integrationRoutes.js). Unset means
# the route always returns 503, never an unprotected 200. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_API_KEY=
